@model IEnumerable<RestulAPiCRUD.Models.Student>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>

</p>

@{
    if (TempData["Message"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            <strong>Success..!</strong> @TempData["Message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    if (TempData["UpdateData"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            <strong>Success..!</strong> @TempData["UpdateData"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    if (TempData["DeletedData"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            <strong>Success..!</strong> @TempData["DeletedData"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }


}
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.sName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.sAge)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.sGender)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.sFatherName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.sClass)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.sName)
            </td>
            <td>
                @Html.DisplayFor(model => item.sAge)
            </td>
            <td>
                @Html.DisplayFor(model => item.sGender)
            </td>
            <td>
                @Html.DisplayFor(model => item.sFatherName)
            </td>
            <td>
                @Html.DisplayFor(model => item.sClass)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.id" class="btn btn-primary">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.id" class="btn btn-success">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.id" class="btn btn-danger">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
